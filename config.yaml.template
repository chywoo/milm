# ==============================================================================
# MILM Configuration Template (config.yaml.template)
# ==============================================================================
# 이 파일을 복사하여 'config.yaml'로 이름을 변경한 뒤 사용자 환경에 맞게 수정하여 사용하세요:
#   $ cp config.yaml.template config.yaml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 모델 아키텍처 하이퍼파라미터 (Model Configuration)
# ------------------------------------------------------------------------------
model:
  vocab_size: 256         # 문자 집합/어휘 크기 (학습 시 데이터셋 토크나이저에 의해 동적 업데이트됨)
  seq_len: 128            # 최대 문맥 길이 (Context Window / Sequence Length)
  d_model: 256            # 임베딩 및 히든 차원 (Embedding / Hidden Dimension)
  num_heads: 8            # Multi-Head Attention Head 수 (d_model의 약수여야 함)
  num_layers: 6           # Transformer Block 레이어 수
  d_ff: 1024              # FFN 내부 확장 차원 (일반적으로 4 * d_model)
  dropout: 0.1            # 드롭아웃 비율

# ------------------------------------------------------------------------------
# 2. 학습 및 인프라 최적화 설정 (Training Configuration)
# ------------------------------------------------------------------------------
train:
  data_dir: "data"                # 훈련 텍스트 파일(.txt)들이 위치한 디렉토리 경로
  checkpoint_dir: "checkpoints"   # 모델 가중치 및 토크나이저 저장 디렉토리
  checkpoint_name: "best_model.pt" # 최적 모델 가중치 파일명
  
  batch_size: 64                  # 훈련 미니배치 크기
  epochs: 10                      # 총 학습 에포크 수
  learning_rate: 0.0005           # 초기 최대 학습률 (5e-4)
  min_lr: 0.00005                 # Cosine Annealing 스케줄러 최소 학습률 (5e-5)
  warmup_steps: 100               # Linear Warmup 스텝 수
  weight_decay: 0.01              # 가중치 감쇠 (L2 Regularization)
  grad_clip: 1.0                  # 기울기 폭주 방지 클리핑 (Max Norm)
  
  device: "auto"                  # 연산 디바이스 ("auto", "cuda", "mps", "cpu")
  use_amp: true                   # Automatic Mixed Precision (FP16) 활성화 여부
  compile_model: true             # PyTorch 2.0+ torch.compile 활성화 여부 (CUDA 전용)
  val_split: 0.1                  # 검증 데이터셋 분할 비율 (0.0 ~ 1.0)
  profile: false                  # PyTorch 통합 프로파일러 활성화 여부
  profile_dir: "profiler_logs"    # 프로파일링 결과(트레이스) 저장 디렉토리 경로
