# ==============================================================================
# MILM Configuration Template (config.yaml.template)
# ==============================================================================
# Copy this file to 'config.yaml' and customize it for your environment:
#   $ cp config.yaml.template config.yaml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Architecture Hyperparameters (Model Configuration)
# ------------------------------------------------------------------------------
model:
  vocab_size: 256         # Character set / vocabulary size (dynamically updated by dataset tokenizer during training)
  seq_len: 128            # Maximum context length (Context Window / Sequence Length)
  d_model: 256            # Embedding and hidden dimension
  num_heads: 8            # Number of Multi-Head Attention heads (must divide d_model)
  num_layers: 6           # Number of Transformer Block layers
  d_ff: 1024              # FFN inner expansion dimension (typically 4 * d_model)
  dropout: 0.1            # Dropout rate
  emit_nvtx: true         # Enable NVTX marker emission for profiler (torch.profiler emit_nvtx)

# ------------------------------------------------------------------------------
# 2. Training and Infrastructure Optimization (Training Configuration)
# ------------------------------------------------------------------------------
train:
  data_dir: "data"                # Directory path containing training text files (.txt)
  checkpoint_dir: "checkpoints"   # Directory to save model weights and tokenizer
  checkpoint_name: "best_model.pt" # Best model checkpoint filename
  
  batch_size: 64                  # Training mini-batch size
  epochs: 10                      # Total training epochs
  learning_rate: 0.0005           # Initial maximum learning rate (5e-4)
  min_lr: 0.00005                 # Cosine Annealing scheduler minimum learning rate (5e-5)
  warmup_steps: 100               # Linear warmup steps
  weight_decay: 0.01              # Weight decay (L2 Regularization)
  grad_clip: 1.0                  # Gradient clipping max norm
  
  device: "auto"                  # Compute device ("auto", "cuda", "mps", "cpu")
  use_amp: true                   # Enable Automatic Mixed Precision (FP16)
  compile_model: true             # Enable PyTorch 2.0+ torch.compile (CUDA only)
  val_split: 0.1                  # Validation dataset split ratio (0.0 ~ 1.0)
  profile: false                  # Enable PyTorch Profiler
  profile_dir: "profiler_logs"    # Directory path to save profiling traces
  emit_nvtx: true                 # Enable NVTX marker emission for profiler (torch.profiler emit_nvtx)
